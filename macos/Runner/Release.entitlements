<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- yt-dlp fetches metadata over HTTPS and streams media from the CDN.
	     Without network.client a sandboxed Release build cannot resolve or
	     connect to anything, so every download fails. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The download-folder picker and the cookies.txt import both need to
	     read and write files the user chose, outside the app container. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
